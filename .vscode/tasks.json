{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Convert MD to PDF",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/mdpdf.sh",
            "args": ["${file}"],
            "group": "build",
            "presentation": {
                "reveal": "silent",
                "showReuseMessage": false,
            },
            "runOptions": {
                "instanceLimit": 1
            },
            "options": {
                "cwd": "${relativeFileDirname}"
            },
            "problemMatcher": []
        }
    ]
}
